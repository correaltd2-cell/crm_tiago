rules_version = '2';
// Padrão inicial: aberto (equivalente às policies abertas do desenho original —
// o filtro por representante é feito no app). Para endurecer depois, integre
// Firebase Auth e restrinja por request.auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
